rules_version = '2';

// Leitura pública; escrita só para admins com e-mail Google verificado.
// Para adicionar admins: incluir o e-mail na lista abaixo (e em NEXT_PUBLIC_ADMIN_EMAILS).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['matheusjouan@gmail.com'];
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
